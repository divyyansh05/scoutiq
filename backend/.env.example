# ============================================================
# ScoutIQ Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Default: football-etl-pipeline running via Docker on port 5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/football_data

# ── Application ──────────────────────────────────────────────
# Chelsea FC team_id in the teams table (used for dashboard focus)
CHELSEA_TEAM_ID=6

# Minimum minutes for a player to be included in scoring/search
MIN_MINUTES=450

# ── AI Features (Phase 3 — not yet active) ───────────────────
# Required for AI Scout Assistant and player summaries
# Get from: console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ── Cache (optional) ─────────────────────────────────────────
# Redis URL — app works without Redis, faster with it
# TTL: 3600s search results, 300s player profiles
# REDIS_URL=redis://localhost:6379

# ── Environment ──────────────────────────────────────────────
# Set to 'production' in deployed environments
# Controls logging level and error detail exposure
ENVIRONMENT=development
